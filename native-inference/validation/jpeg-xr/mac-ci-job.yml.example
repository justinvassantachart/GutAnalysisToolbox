# Copy this job under jobs: in the owner-managed validation workflow.
native-jpeg-xr:
  name: Native Mac JPEG-XR golden fixture decode
  runs-on: macos-14
  timeout-minutes: 20
  steps:
    - uses: actions/checkout@v5
    - uses: actions/setup-java@v5
      with:
        distribution: temurin
        java-version: '21'
    - name: Verify native host and install official SWIG if absent
      run: |
        test "$(uname -m)" = arm64
        command -v swig || brew install swig
    - name: Exercise source-built JNI through Bio-Formats codec
      run: >-
        python3 native-inference/validation/jpeg-xr/check.py
        --mode native --expect-platform osx_arm64 --output target/jpeg-xr-mac
    - name: Preserve diagnostics only
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: gat-native-mac-jpeg-xr-diagnostics
        path: |
          target/jpeg-xr-mac/*.json
          target/jpeg-xr-mac/*.tsv
          target/jpeg-xr-mac/*.log
        if-no-files-found: error
